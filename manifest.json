{
  "manifest_version": 3,
  "name": "Brow",
  "version": "1.0.0",
  "description": "LangGraph.js agent with MCP, MCP Apps, WebMCP tab tools, and dynamic WebMCP discovery",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "bookmarks",
    "history",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["webmcp-polyfill.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' http: https: blob: data:; style-src 'self' 'unsafe-inline' http: https:; img-src 'self' http: https: data: blob:; font-src 'self' http: https: data:; media-src 'self' http: https: data: blob:; connect-src 'self' http: https: ws: wss:; child-src 'self' blob: data:;"
  },
  "sandbox": {
    "pages": ["mcp-app-sandbox.html"]
  },
  "icons": {
    "16": "icons/extension-icon.png",
    "48": "icons/extension-icon.png",
    "128": "icons/extension-icon.png"
  },
  "action": {
    "default_title": "Brow",
    "default_icon": {
      "16": "icons/extension-icon.png",
      "48": "icons/extension-icon.png",
      "128": "icons/extension-icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/extension-icon.png", "icons/icon.png", "icons/openai.png", "icons/claude.png", "icons/cursors.png"],
      "matches": ["<all_urls>"]
    }
  ]
}

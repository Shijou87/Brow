{
  "manifest_version": 3,
  "name": "Brow",
  "version": "1.0.0",
  "description": "LangGraph.js agent with MCP, MCP Apps, WebMCP tab tools, and dynamic WebMCP discovery",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "bookmarks",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["webmcp-polyfill.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/extension-icon.png",
    "48": "icons/extension-icon.png",
    "128": "icons/extension-icon.png"
  },
  "action": {
    "default_title": "Brow",
    "default_icon": {
      "16": "icons/extension-icon.png",
      "48": "icons/extension-icon.png",
      "128": "icons/extension-icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/extension-icon.png", "icons/icon.png", "icons/openai.png", "icons/claude.png", "icons/cursors.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
